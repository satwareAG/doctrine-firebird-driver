<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/11.5/phpunit.xsd"
         colors="true"
         bootstrap="phpunit.bootstrap.php"
         cacheDirectory=".phpunit.cache"
         executionOrder="depends,defects"
         requireCoverageMetadata="false"
         beStrictAboutCoverageMetadata="false"
         failOnRisky="true"
         failOnWarning="true"
         failOnDeprecation="true"
         failOnNotice="true"
         displayDetailsOnTestsThatTriggerDeprecations="true"
         displayDetailsOnTestsThatTriggerErrors="true"
         displayDetailsOnTestsThatTriggerNotices="true"
         displayDetailsOnTestsThatTriggerWarnings="true"
>
  <php>
    <ini name="error_reporting" value="-1"/>
    <var name="db_driver_class" value="Satag\DoctrineFirebirdDriver\Driver\Firebird\Driver"/>
    <var name="db_host" value="127.0.0.1"/>
    <var name="db_user" value="sysdba"/>
    <var name="db_password" value="masterkey"/>
    <var name="db_dbname" value="/firebird/data/test.fdb"/>
    <var name="db_charset" value="UTF8" />
    <var name="db_test_logging" value="0" />
    <var name="PHP_IDE_CONFIG" value="serverName=phpconsole" />
    <ini name="memory_limit" value="4G"/>
  </php>

  <testsuites>
    <testsuite name="Unit">
      <directory>Test/Unit</directory>
      <directory>Test/Platforms</directory>
      <directory>Test/Tools</directory>
    </testsuite>
    <testsuite name="Integration-ReadOnly">
      <file>Test/Integration/Doctrine/ORM/QueryBuilder/AlbumTest.php</file>
      <file>Test/Integration/Doctrine/ORM/EntityManager/Repository/FindTest.php</file>
      <file>Test/Integration/Doctrine/ORM/EntityManager/Repository/FindAllTest.php</file>
      <file>Test/Integration/Doctrine/ORM/EntityManager/Repository/FindByTest.php</file>
      <file>Test/Integration/Doctrine/ORM/EntityManager/Repository/FindOneByTest.php</file>
    </testsuite>
    <testsuite name="Integration-Write">
      <directory>Test/Integration</directory>
      <directory>Test/Driver</directory>
      <exclude>Test/Integration/Doctrine/ORM/QueryBuilder/AlbumTest.php</exclude>
      <exclude>Test/Integration/Doctrine/ORM/EntityManager/Repository/FindTest.php</exclude>
      <exclude>Test/Integration/Doctrine/ORM/EntityManager/Repository/FindAllTest.php</exclude>
      <exclude>Test/Integration/Doctrine/ORM/EntityManager/Repository/FindByTest.php</exclude>
      <exclude>Test/Integration/Doctrine/ORM/EntityManager/Repository/FindOneByTest.php</exclude>
    </testsuite>
    <testsuite name="Functional">
      <directory>Test/Functional</directory>
    </testsuite>
  </testsuites>

  <source>
    <include>
      <directory suffix=".php">../src</directory>
    </include>
  </source>
</phpunit>
