parameters:
    level: 8
    phpVersion: 80300
    paths:
        - src
    # KNOWN ISSUE: PHP crashes with SIGSEGV after PHPStan completes when php-firebird extension is loaded.
    #
    # Root Cause: The ext-firebird extension has a shutdown bug triggered when PHPStan uses reflection
    # to analyze classes that reference Firebird types. The crash occurs AFTER analysis completes,
    # during PHP's RSHUTDOWN/MSHUTDOWN phase. This is NOT solely a fork-safety issue - it also
    # crashes in single-threaded mode (--debug flag).
    #
    # Analysis completes successfully and outputs "[OK] No errors" before the crash,
    # so the analysis results are valid.
    #
    # WORKAROUND OPTIONS:
    # 1. Run PHPStan in a PHP environment WITHOUT ext-firebird:
    #    docker run --rm -v "$(pwd):/app" -w /app php:8.1-cli vendor/bin/phpstan analyse
    # 2. Accept exit code 139 in CI (analysis completes before crash)
    # 3. Use maximumNumberOfProcesses: 1 to reduce crash frequency (doesn't prevent it)
    #
    # See: https://github.com/satwareAG/php-firebird/issues/55
    # See: docs/issues/2025-12-23-phpstan-parallel-segfault-investigation.md
    parallel:
        maximumNumberOfProcesses: 1
    stubFiles:
        - stubs/FirebirdStub.php
        - stubs/FirebirdOO.php
    bootstrapFiles:
       - vendor/autoload.php
    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        - identifier: missingType.generics
        # https://github.com/phpstan/phpstan-strict-rules/issues/103
        -
            message: '~^Construct empty\(\) is not allowed. Use more strict comparison\.~'
            paths:
                - src/Driver/*/Driver.php
                - src/Platforms/*Platform.php
                - src/Schema/*SchemaManager.php

        # In some namespaces, we use array<string,mixed>, some elements of which are actually boolean
        -
            message: '~^Only booleans are allowed in .*, mixed given~'
            paths:
                - src/Platforms/*Platform.php
                - src/Schema/*SchemaManager.php

        -
            message: '#Used function fbird_set_exception_mode not found#'
            paths:
                - src/Driver/Firebird/Connection.php
        -
            message: '#Used constant FBIRD_EXCEPTION_MODE_THROW not found#'
            paths:
                - src/Driver/Firebird/Connection.php

includes:
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/phpstan/phpstan-doctrine/extension.neon
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon
    - phpstan-baseline.neon
