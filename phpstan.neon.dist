parameters:
    level: 8
    phpVersion: 80200
    paths:
        - src
    # NOTE: SIGSEGV issue with php-firebird extension was resolved in v7.0.0-rc.37
    # See: https://github.com/satwareAG/php-firebird/issues/55
    # See: docs/issues/2025-12-23-phpstan-parallel-segfault-investigation.md
    # NOTE: Use scanFiles (not stubFiles) so PHPStan discovers fbird_*
    # functions/constants.  The CI quality-checks job installs ext-firebird
    # so PHPStan sees native types; scanFiles supplement with userland classes
    # and v10-specific constants.
    scanFiles:
        - vendor/satwareag/php-firebird-stubs/firebird-stubs.php
        - vendor/satwareag/php-firebird-stubs/firebird-classes.php
        - stubs/firebird-batch-stubs.php
        - stubs/firebird-userland-classes.php
        - stubs/firebird-v10-functions.php
    bootstrapFiles:
       - vendor/autoload.php
    treatPhpDocTypesAsCertain: false
    reportUnmatchedIgnoredErrors: true
    ignoreErrors:
        - identifier: missingType.generics
        # https://github.com/phpstan/phpstan-strict-rules/issues/103
        -
            message: '~^Construct empty\(\) is not allowed. Use more strict comparison\.~'
            paths:
                - src/Driver/*/Driver.php
                - src/Platforms/*Platform.php

        # In some namespaces, we use array<string,mixed>, some elements of which are actually boolean
        # (Platforms variant removed 2026-10-27: unmatched under DBAL 4.5 resolution, #249)
        -
            message: '~^Only booleans are allowed in .*, mixed given~'
            paths:
                - src/Schema/*SchemaManager.php

        # Deprecated DBAL methods called intentionally for backward compatibility
        # These will be updated when we drop support for the current DBAL version

        # DBAL 4.5 (dbal#7490) deprecations on the Column API. Calls exist in
        # version-conditional branches (src/Compat/ColumnCompat.php) or in-place
        # mutation paths that DBAL 4.4 offers as its only mechanism. Each call is
        # guarded by method_exists or runs only under the version where the API
        # is current. To be removed when support for DBAL 4.4 is dropped.
        -
            message: '#Call to deprecated method getType\(\) of class Doctrine\\DBAL\\Schema\\Column#'
            paths:
                - src/Compat/ColumnCompat.php
        -
            message: '#Call to deprecated method set(Comment|Default|Length|PlatformOptions|Type)\(\) of class Doctrine\\DBAL\\Schema\\Column#'
            paths:
                - src/Platforms/
                - src/Schema/

        # Cross-version bridge: method_exists() guards flip between always-true and
        # always-false depending on the resolved DBAL vendor (4.4 vs 4.5). Static
        # narrowing is therefore meaningless here by construction.
        -
            identifier: function.alreadyNarrowedType
            paths:
                - src/Compat/ColumnCompat.php

        # Deferred to the DBAL 5.0 readiness review (#253, operator disposition
        # 2026-10-31): the quoted-name deprecation family is soft-deprecated -
        # DBAL 4.5 core itself calls getQuotedName 23x in AbstractPlatform and its
        # keyword classes still extend the deprecated KeywordList - and removal
        # targets DBAL 5.0. The getSetTransactionIsolationSQL entry is the
        # operator-permanent wider-contract exception (same disposition).
        # Ratchet: reportUnmatchedIgnoredErrors=true fails CI the moment a DBAL
        # release drops one of these APIs, forcing the migration in the same
        # change. Do not add entries here without a #253-linked rationale.
        # Scope note: the prefix patterns also suppress NEW calls to the same
        # methods added under the same paths - the ratchet fires on API removal,
        # not on new call sites. A new call to a family method requires a
        # #253-linked review note before merging (#253, 2026-11-04).
        -
            message: '#^Call to deprecated method (getName|getQuotedName|isQuoted)\(\) of class Doctrine\\DBAL\\Schema\\AbstractAsset#'
            paths:
                - src/Platforms/
                - src/Schema/
        -
            message: '#^Call to deprecated method quoteIdentifier\(\) of class Doctrine\\DBAL\\Platforms\\AbstractPlatform#'
            paths:
                - src/Platforms/
                - src/Schema/
        -
            message: '#^Call to deprecated method getRenamedColumns\(\) of class Doctrine\\DBAL\\Schema\\TableDiff#'
            paths:
                - src/Platforms/
        -
            message: '#^Call to deprecated method getPlatformOptions\(\) of class Doctrine\\DBAL\\Schema\\Column#'
            paths:
                - src/Schema/FirebirdComparator.php
        -
            message: '#^Method Satag\\DoctrineFirebirdDriver\\Platforms\\FirebirdPlatform\:\:getSetTransactionIsolationSQL\(\) has parameter \$level with no type specified\.$#'
            paths:
                - src/Platforms/FirebirdPlatform.php
        -
            identifier: class.extendsDeprecatedClass
            paths:
                - src/Platforms/Keywords/

includes:
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/phpstan/phpstan-doctrine/extension.neon
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon
