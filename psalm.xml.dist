<?xml version="1.0"?>
<psalm
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
    findUnusedBaselineEntry="false"
    findUnusedCode="true"
    errorBaseline="psalm-baseline.xml"
>
    <projectFiles>
        <directory name="src" />
        <ignoreFiles>
            <directory name="vendor" />
        </ignoreFiles>

    </projectFiles>
    <stubs>
        <file name="vendor/jetbrains/phpstorm-stubs/interbase/interbase.php" />
        <file name="vendor/satwareag/php-firebird-stubs/firebird-stubs.php" />
        <file name="vendor/satwareag/php-firebird-stubs/firebird-classes.php" />
        <file name="stubs/firebird-userland-classes.php" />
    </stubs>
    <issueHandlers>
        <!-- MissingOverrideAttribute: all #[Override] usages in this project use the
             Compat\Override polyfill attribute, not PHP 8.3's native #[\Override].
             Psalm (CI, ext-firebird installed) cannot recognise the custom attribute as
             equivalent, so it reports MissingOverrideAttribute on every overriding method.
             Suppressed project-wide since the polyfill is intentional. -->
        <MissingOverrideAttribute>
            <errorLevel type="suppress">
                <directory name="src"/>
            </errorLevel>
        </MissingOverrideAttribute>
        <!-- DocblockTypeContradiction / PossiblyInvalidArgument in Connection.php:
             php-firebird v10+ fbird_* functions accept Firebird\Connection objects as
             well as legacy resources. Psalm (CI) resolves the OO types via ext-firebird
             stubs and reports contradictions with docblock resource-only type hints.
             The runtime logic is correct; suppress here until stubs are updated. -->
        <DocblockTypeContradiction>
            <errorLevel type="suppress">
                <file name="src/Driver/Firebird/Connection.php"/>
            </errorLevel>
        </DocblockTypeContradiction>
        <PossiblyInvalidArgument>
            <errorLevel type="suppress">
                <file name="src/Driver/Firebird/Connection.php"/>
            </errorLevel>
        </PossiblyInvalidArgument>
        <InternalClass>
            <errorLevel type="suppress">
                <referencedClass name="Doctrine\DBAL\SQL\Parser"/>
                <file name="src/Driver/Firebird/Exception.php"/>
                <file name="src/Driver/Firebird/Result.php"/>
                <file name="src/Driver/Firebird/Exception/HostDbnameRequired.php"/>
            </errorLevel>
        </InternalClass>
        <InternalMethod>
            <errorLevel type="suppress">
                <file name="src/Schema/FirebirdSchemaManager.php"/>
                <file name="src/Driver/Firebird/Connection.php"/>
                <file name="src/Driver/Firebird/Exception.php"/>
                <file name="src/Driver/Firebird/Exception/HostDbnameRequired.php"/>
                <file name="src/Driver/Firebird/ExceptionConverter.php"/>
                <file name="src/Driver/Firebird/Result.php"/>
                <file name="src/Driver/Firebird/Statement.php"/>
                <file name="src/Platforms/FirebirdPlatform.php"/>
                <file name="src/Platforms/SQL/Builder/FirebirdSelectSQLBuilder.php"/>
            </errorLevel>
        </InternalMethod>
        <PossiblyUnusedMethod>
            <errorLevel type="suppress">
                <referencedMethod name="Satag\DoctrineFirebirdDriver\Driver\Firebird\Connection::getAttribute"/>
                <referencedMethod name="Satag\DoctrineFirebirdDriver\Driver\Firebird\Connection::getNativeConnection"/>
                <referencedMethod name="Satag\DoctrineFirebirdDriver\Platforms\FirebirdPlatform::setCharTrue"/>
                <referencedMethod name="Satag\DoctrineFirebirdDriver\Platforms\FirebirdPlatform::setCharFalse"/>
                <referencedMethod
                        name="Satag\DoctrineFirebirdDriver\Platforms\FirebirdPlatform::setUseSmallIntBoolean"/>
                <referencedMethod
                        name="Satag\DoctrineFirebirdDriver\Platforms\FirebirdPlatform::assertValidIdentifier"/>
                <referencedMethod
                        name="Satag\DoctrineFirebirdDriver\Schema\FirebirdSchemaManager::getFieldTypeIdToColumnTypeMap"/>
                <referencedMethod
                        name="Satag\DoctrineFirebirdDriver\Platforms\Firebird4Platform::getTimeTzFormatString"/>
            </errorLevel>
        </PossiblyUnusedMethod>
    </issueHandlers>
</psalm>
