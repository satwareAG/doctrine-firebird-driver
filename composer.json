{
    "name": "satag/doctrine-firebird-driver",
    "type": "library",
    "description": "Doctrine DBAL/ORM driver for Firebird SQL 3.0 and newer",
    "license": "MIT",
    "keywords": [
        "firebird",
        "interbase",
        "fbird",
        "sql",
        "dbal",
        "orm",
        "doctrine",
        "firebird driver",
        "database driver",
        "sql driver"
    ],
    "authors": [
        {
            "name": "Michael Wegener",
            "email": "mw@satware.com"
        },
        {
            "name": "Kasper Søfren",
            "email": "soefritz@gmail.com"
        },
        {
            "name": "Uffe Petersen"
        }
    ],
    "support": {
        "issues": "https://github.com/satwareAG/doctrine-firebird-driver/issues",
        "source": "https://github.com/satwareAG/doctrine-firebird-driver"
    },
    "config": {
        "platform": {
            "php": "8.2.27"
        },
        "sort-packages": true,
        "allow-plugins": {
            "bamarni/composer-bin-plugin": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "composer/package-versions-deprecated": true
        }
    },
    "autoload": {
        "psr-4": {
            "Satag\\DoctrineFirebirdDriver\\": "src/"
        },
        "files": [
            "src/Compat/Compat.php"
        ]
    },
    "extra": {
        "bamarni-bin": {
            "bin-links": true,
            "forward-command": true
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Satag\\DoctrineFirebirdDriver\\Test\\": "tests/Test/"
        }
    },
    "require": {
        "php": "^8.2",
        "ext-firebird": "^13.0",
        "ext-mbstring": "*",
        "composer-runtime-api": "^2",
        "doctrine/dbal": "^4.4",
        "symfony/polyfill-intl-grapheme": "^1.33",
        "symfony/polyfill-intl-normalizer": "^1.33",
        "symfony/polyfill-php83": "^1.33",
        "symfony/polyfill-php84": "^1.33",
        "symfony/polyfill-php85": "^1.33"
    },
    "require-dev": {
        "bamarni/composer-bin-plugin": "^1.9",
        "dg/bypass-finals": "^1.9",
        "doctrine/coding-standard": "^14.0.0",
        "doctrine/deprecations": "^1.1",
        "doctrine/instantiator": "^2.0",
        "doctrine/orm": "^3.6",
        "fig/log-test": "^1.2",
        "jetbrains/phpstorm-stubs": "2025.3",
        "monolog/monolog": "^3.8",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^11.5",
        "psalm/plugin-phpunit": "^0.19.5",
        "react/child-process": "^0.6.7",
        "satwareag/php-firebird-stubs": "^13.0.0",
        "slevomat/coding-standard": "^8.28",
        "squizlabs/php_codesniffer": "^4.0.1",
        "symfony/cache": "^6.4|^7.0",
        "symfony/console": "^6.4|^7.0",
        "symfony/var-exporter": "^6.4|^7.0",
        "vimeo/psalm": "^6.16"
    }
}
